# 1. Configure the kubectl provider to talk to local EKS
provider "kubectl" {
  host                   = aws_eks_cluster.main.endpoint
  cluster_ca_certificate = base64decode(aws_eks_cluster.main.certificate_authority[0].data)
  load_config_file       = false

  exec {
    api_version = "client.authentication.k8s.io/v1beta1"
    command     = "aws"
    args        = ["eks", "get-token", "--cluster-name", aws_eks_cluster.main.name]
  }
}

# 2. Argo CD Namespace
resource "kubernetes_namespace" "argocd" {
  metadata {
    name = "argocd"
  }
  depends_on = [aws_eks_node_group.main_nodes]
}

# 3. Helm Release for Argo CD
resource "helm_release" "argocd" {
  name       = "argocd"
  repository = "https://argoproj.github.io/argo-helm"
  chart      = "argo-cd"
  namespace  = kubernetes_namespace.argocd.metadata[0].name
  version    = "6.7.18"

  depends_on = [kubernetes_namespace.argocd]
}

# 4. Target Application Namespace (with Istio injection enabled)
resource "kubernetes_namespace" "bookverse" {
  metadata {
    name = "bookverse"

    labels = {
      "istio-injection" = "enabled"
    }
  }
}

# 5. Bootstrap GitOps Root Application Stack via kubectl_manifest
resource "kubectl_manifest" "argocd_root_application" {
  yaml_body = <<YAML
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: bookverse-application-stack
  namespace: argocd
spec:
  project: default
  source:
    repoURL: https://github.com/goniusman/GitOps.git
    targetRevision: main
    path: helm/argocd-apps
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
YAML

  depends_on = [
    helm_release.argocd,
    kubernetes_namespace.bookverse
  ]
}